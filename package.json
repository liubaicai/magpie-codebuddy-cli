{
  "name": "@magpie-community/opencode-codebuddy-cli-auth",
  "version": "0.1.7",
  "description": "Magpie/OpenCode model provider that connects your local CodeBuddy CLI through the Agent Client Protocol (codebuddy --acp), so CodeBuddy subscription models run through the real CLI",
  "type": "module",
  "main": "./opencode.mjs",
  "exports": {
    ".": "./opencode2.mjs"
  },
  "files": [
    "index.mjs",
    "acp.mjs",
    "accounts.mjs",
    "credits.mjs",
    "mcp-bridge.mjs",
    "translate.mjs",
    "session-pool.mjs",
    "platform.mjs",
    "opencode.mjs",
    "opencode2.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "assets/workbuddy.webp"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "codebuddy",
    "tencent",
    "acp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liubaicai/magpie-codebuddy-cli.git"
  },
  "homepage": "https://github.com/liubaicai/magpie-codebuddy-cli#readme",
  "bugs": {
    "url": "https://github.com/liubaicai/magpie-codebuddy-cli/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "magpie": {
    "maxConcurrency": 8,
    "name": "Codebuddy CLI",
    "icon": "data:image/webp;base64,"
  }
}
